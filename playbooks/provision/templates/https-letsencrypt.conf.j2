# HTTPS server configuration.

# Redirect HTTP traffic to HTTPS.
server {
    listen 80 default_server;
    server_name _;
    index index.html;
    root {{ nginx_docroot }};
    access_log /var/log/nginx/{{ inventory_hostname }}.access.log;
    error_log /var/log/nginx/{{ inventory_hostname }}.error.log;

    location /.well-known/acme-challenge/ { }

    location / {
        return 301 https://$host$request_uri;
    }
}

{% if host_cert_ready | default(true) %}
# Serve HTTPS traffic using the Let's Encrypt certificate.
server {
    listen 443 ssl default_server;
    server_name {{ inventory_hostname }};
    root {{ nginx_docroot }};

    access_log /var/log/nginx/{{ inventory_hostname }}.access.log;
    error_log /var/log/nginx/{{ inventory_hostname }}.error.log;

    ssl_certificate /etc/letsencrypt/live/{{ inventory_hostname }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ inventory_hostname }}/privkey.pem;
    include /etc/nginx/conf.d/{{ inventory_hostname }}.*.locations;
}
{% endif %}
