[Unit]
Description={{ service_description }}
After=syslog.target

[Service]
Type=simple
User={{ username }}
Group={{ username }}
WorkingDirectory=/home/{{ username }}/src/{{ service_working_dir }}
{% if service_port is defined %}
Environment=PORT={{ service_port }}
{% endif %}
ExecStart=/home/{{ username }}/src/{{ service_script_filename }}
Restart=always

[Install]
WantedBy=multi-user.target
